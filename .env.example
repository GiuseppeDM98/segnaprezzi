# Copy to .env.local and fill in. Never commit .env.local (enforced via .gitignore).
#
# If a Vercel project is linked (`vercel link`), `vercel env pull .env.local`
# overwrites this file with the project's Development scope, and every value
# below is filled with a real one: Vercel keeps TURSO_DATABASE_URL="file:local.db"
# and BETTER_AUTH_URL as they already are here for Development, but
# ANTHROPIC_API_KEY and BLOB_READ_WRITE_TOKEN become the real key and token,
# and BETTER_AUTH_SECRET becomes a local-only secret distinct from
# production's — so the capture and receipt flows reach the real model and
# the real Blob store even on localhost, without ever touching the
# production database.

# Turso — use a local SQLite file in development
TURSO_DATABASE_URL="file:local.db"
# Required only for remote libsql:// URLs
TURSO_AUTH_TOKEN=""

# Anthropic — Claude Haiku 4.5 price-tag extraction
ANTHROPIC_API_KEY=""

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob — auto-set when a Blob store is connected on Vercel;
# create a store and copy a token for local development
BLOB_READ_WRITE_TOKEN=""

# Set to "false" to close registration (default: open)
SIGNUP_ENABLED="true"
